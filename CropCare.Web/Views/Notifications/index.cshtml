@model CropCare.Web.Models.NotificationsPageModel
@{ ViewData["Title"] = "Notifications"; var today=CropCare.Web.Models.ZoneDates.Today; }
<div class="cc-section-heading"><h2>Alerts and updates</h2><div class="cc-actions"><a class="btn btn-light" asp-action="Index">⟳ Refresh</a><form asp-action="ClearAll" method="post" asp-antiforgery="true" data-confirm="Clear notification history? Soil records will not be removed."><button class="btn btn-danger" type="submit">Clear All</button></form></div></div>
@if(Model.Error is not null){<div class="alert alert-warning" role="alert">@Model.Error</div>}else if(Model.Notifications.Count==0){<div class="cc-empty">No notifications yet.</div>}
<div class="cc-grid">@foreach(var group in Model.Notifications.GroupBy(n=>CropCare.Web.Models.SensorDates.Day(n.TimestampMs)==today ? "Today" : "Earlier")){<section class="cc-card cc-stack"><h3>@group.Key</h3>@foreach(var n in group){<article class="cc-option"><h3 class="h5">@(!n.IsRead ? "● " : "")@n.Title</h3><p>@n.Message</p><small>@n.TimeText</small><div class="cc-actions mt-3">@if(!n.IsRead){<form asp-action="MarkRead" method="post" asp-antiforgery="true"><input name="id" type="hidden" value="@n.Id" /><button class="btn btn-light btn-sm" type="submit">Mark read</button></form>}<form asp-action="Remove" method="post" asp-antiforgery="true" data-confirm="Delete this notification?"><input name="id" type="hidden" value="@n.Id" /><button class="btn btn-danger btn-sm" type="submit">Delete</button></form></div></article>}</section>}</div><p class="small text-muted mt-4">Showing up to 100 latest notifications. Clear All removes at most 5,000 records per request; refresh and repeat if older records remain.</p>
