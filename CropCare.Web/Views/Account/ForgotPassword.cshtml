@model CropCare.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="row justify-content-center py-5">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card rounded-4 border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 fw-bold text-success">Forgot Password?</h1>
                <p class="text-muted">Enter your registered email address. Firebase will send a secure reset link if the account exists.</p>
                @if (ViewBag.Message is string message)
                {
                    <div class="alert alert-success" role="status">@message</div>
                }
                <form asp-action="ForgotPassword" method="post" asp-antiforgery="true">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                    <button type="submit" class="btn btn-success w-100 mt-4">Send Reset Link</button>
                </form>
                <a asp-controller="Account" asp-action="Login" class="d-block text-center mt-3">Back to Login</a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
