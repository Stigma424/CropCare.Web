@model CropCare.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Login"; }
<h1>Welcome back</h1><p class="text-muted">Sign in to continue to CropCare</p>
<form class="cc-auth-form" asp-controller="Account" asp-action="Login" method="post" asp-antiforgery="true">
<input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="30" placeholder="Username" /><span asp-validation-for="Username" class="text-danger"></span></div>
<div><label asp-for="Password" class="form-label"></label><div class="cc-password"><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Password" /><button type="button" data-password-toggle="Password" aria-label="Show password" aria-pressed="false">Show</button></div><span asp-validation-for="Password" class="text-danger"></span></div>
<a asp-controller="Recovery" asp-action="Request" class="fw-bold">Forgot Password?</a><div class="cc-auth-actions"><button class="btn btn-success" type="submit">LOGIN</button><a class="btn btn-light" asp-action="Register">Register</a></div></form>
<p class="cc-auth-footer text-muted">Don't have an account? <a asp-action="Register">Create an account</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
