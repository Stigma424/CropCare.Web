@{ ViewData["Title"] = "Log out"; }
<section class="cc-card cc-logout text-center"><h2>Are you sure you want to log out?</h2><p class="text-muted">You will need your username and password to sign in again.</p><div class="cc-auth-actions mt-4"><a class="btn btn-light" asp-controller="Settings" asp-action="Index">No</a><form asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="true"><button class="btn btn-danger w-100" type="submit">Yes, log out</button></form></div></section>
