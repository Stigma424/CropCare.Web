@model CropCare.Web.Models.RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<h1>Register</h1><p class="text-muted">Create your account to get started</p>
<form class="cc-auth-form" asp-action="Register" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="cc-form-grid"><div><label asp-for="FirstName" class="form-label">First name</label><input asp-for="FirstName" class="form-control" autocomplete="given-name" maxlength="80" /><span asp-validation-for="FirstName" class="text-danger"></span></div><div><label asp-for="LastName" class="form-label">Last name</label><input asp-for="LastName" class="form-control" autocomplete="family-name" maxlength="80" /><span asp-validation-for="LastName" class="text-danger"></span></div>
<div><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" autocomplete="street-address" maxlength="250" /><span asp-validation-for="Address" class="text-danger"></span></div><div><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autocomplete="username" maxlength="30" /><span asp-validation-for="Username" class="text-danger"></span></div>
<div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div><div><label asp-for="Password" class="form-label"></label><div class="cc-password"><input asp-for="Password" class="form-control" autocomplete="new-password" maxlength="128" /><button type="button" data-password-toggle="Password" aria-pressed="false">Show</button></div><span asp-validation-for="Password" class="text-danger"></span></div>
<div><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><div class="cc-password"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" maxlength="128" /><button type="button" data-password-toggle="ConfirmPassword" aria-pressed="false">Show</button></div><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div></div>
<small class="text-muted">Use 8–128 characters for your password. Email is used for account recovery; sign in with your username.</small><button class="btn btn-success" type="submit">CREATE ACCOUNT</button></form><a class="cc-back-link" asp-action="Login">BACK TO SIGN IN</a>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
