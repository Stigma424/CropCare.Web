@model CropCare.Web.Models.ZoneAssessmentPageModel
@{ViewData["Title"]="Historical assessment";}
<div class="alert alert-info">Historical preview uses stored measurements and current zone metadata. It is not a current reading or fertilizer prescription. No history/assessment writes or push notifications are generated.</div>
<form method="get" class="cc-card cc-actions mb-3"><label for="zoneId">Zone</label><select id="zoneId" name="zoneId" class="form-select w-auto">@foreach(var z in Model.Zones){<option value="@z.ZoneId" selected="@(Model.SelectedZoneId==z.ZoneId)">@z.ZoneName</option>}</select><label for="programId">Reference program</label><select id="programId" name="programId" class="form-select w-auto"><option value="HYB-1" selected="@(Model.Assessment?.ProgramId!="HYB-2")">HYB-1</option><option value="HYB-2" selected="@(Model.Assessment?.ProgramId=="HYB-2")">HYB-2</option></select><button class="btn btn-success">Run historical preview</button></form>
@if(Model.Error is not null){<div class="alert alert-warning">@Model.Error</div>}
@if(Model.Assessment is not null){<partial name="_AssessmentContent" model="Model.Assessment" />}else{<p>No usable historical assessment is available.</p>}
<a class="btn btn-light" asp-controller="Zones" asp-action="Details" asp-route-id="@Model.SelectedZoneId">Back to zone</a>
