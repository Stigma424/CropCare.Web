@{
    ViewData["Title"] = "CropCare Dashboard";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold text-success">CropCare</h1>
        <p class="text-muted">
            IoT-Based Fertilization Monitoring System
        </p>
    </div>

    <div class="row g-3">

        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5>API Connection</h5>
                    <p class="mb-0">@ViewBag.ApiStatus</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Farm Zones</h5>
                    <p class="text-muted">
                        Zone management will appear here.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Soil Monitoring</h5>
                    <p class="text-muted">
                        Latest sensor readings will appear here.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Recommendations</h5>
                    <p class="text-muted">
                        Fertilizer recommendations will appear here.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>
