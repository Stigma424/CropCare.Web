@model CropCare.Web.Models.CropCareProfile
@{ ViewData["Title"] = "Account Settings"; var names = new[]{Model.FirstName,Model.MiddleName,Model.LastName}.Where(x=>!string.IsNullOrWhiteSpace(x)); var initials=string.Concat(new[]{Model.FirstName,Model.LastName}.Where(x=>!string.IsNullOrWhiteSpace(x)).Select(x=>x![0])); }
<div class="cc-grid"><section class="cc-card cc-stack"><div class="cc-avatar">@initials</div><h2>@string.Join(" ",names)</h2><p class="text-success">@Model.Username</p><a class="btn btn-light align-self-start" asp-action="Edit">Edit Profile</a></section><section class="cc-card"><h2>Account information</h2>@foreach(var field in new[]{("First name",Model.FirstName),("Middle name",Model.MiddleName),("Last name",Model.LastName),("Phone number",Model.PhoneNumber),("Email",Model.Email),("Address",Model.Address)}){<div class="cc-details-row"><span>@field.Item1</span><strong>@(string.IsNullOrWhiteSpace(field.Item2) ? "Not set" : field.Item2)</strong></div>}<div class="cc-actions mt-4"><a class="btn btn-success" asp-action="ChangePassword">Change Password</a><a class="btn btn-light" asp-controller="Settings" asp-action="Index">Back to Settings</a></div></section></div>
