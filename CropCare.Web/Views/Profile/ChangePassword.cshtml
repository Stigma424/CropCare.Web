@model CropCare.Web.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }
<div class="cc-grid"><section class="cc-card"><h2>Keep your account secure</h2><p>Verify your current password before choosing a new one. You will sign in again after the change.</p><p class="text-muted">Forgot your current password? Use email recovery from the login page.</p></section><section class="cc-card"><form class="cc-auth-form" asp-action="ChangePassword" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div><label asp-for="CurrentPassword" class="form-label">Current password</label><div class="cc-password"><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><button type="button" data-password-toggle="CurrentPassword" aria-pressed="false">Show</button></div><span asp-validation-for="CurrentPassword" class="text-danger"></span></div><div><label asp-for="NewPassword" class="form-label">New password</label><div class="cc-password"><input asp-for="NewPassword" class="form-control" maxlength="128" autocomplete="new-password" /><button type="button" data-password-toggle="NewPassword" aria-pressed="false">Show</button></div><span asp-validation-for="NewPassword" class="text-danger"></span></div><div><label asp-for="ConfirmNewPassword" class="form-label">Confirm new password</label><div class="cc-password"><input asp-for="ConfirmNewPassword" class="form-control" maxlength="128" autocomplete="new-password" /><button type="button" data-password-toggle="ConfirmNewPassword" aria-pressed="false">Show</button></div><span asp-validation-for="ConfirmNewPassword" class="text-danger"></span></div><div class="cc-auth-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-success" type="submit">Save Password</button></div></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
