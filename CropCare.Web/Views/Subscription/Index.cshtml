@model CropCare.Web.Models.SubscriptionPageViewModel
@{ ViewData["Title"] = "Demo Subscription"; }
<section class="cc-card">
    @if (Model.Error is string error)
    {
        <p class="alert alert-warning">@error</p>
    }
    else
    {
        <h2>Current plan: @(Model.Status.IsSubscribed ? "Pro" : "Free")</h2>
        <p>Switch plans to try CropCare features during the demo.</p>
        <form asp-action="SetDemoPlan" method="post">
            <input type="hidden" name="isSubscribed" value="@(!Model.Status.IsSubscribed ? "true" : "false")" />
            <button class="btn btn-success" type="submit">@(Model.Status.IsSubscribed ? "Switch to Free" : "Activate Pro")</button>
        </form>
    }
</section>
