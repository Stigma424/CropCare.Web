@model CropCare.Web.Models.SubscriptionPageViewModel
@{ ViewData["Title"] = "Subscription"; var state=Model.Error is null ? (Model.Status.Status?.ToLowerInvariant() ?? "unknown") : "unknown"; var known=new[]{"free","pending","rejected","pro"}.Contains(state); }
<div class="cc-grid"><section class="cc-card"><h2>Current plan</h2><span class="badge @(state=="pro" ? "bg-success" : "bg-secondary")">@(known ? state.ToUpperInvariant() : "STATUS UNAVAILABLE")</span><p class="mt-4">@(Model.Error ?? Model.Status.Message)</p>@if(!string.IsNullOrWhiteSpace(Model.Status.ReferenceLastFour)){<p class="text-muted">Reference ending @Model.Status.ReferenceLastFour</p>}@if(Model.Status.SubmittedAtMs.HasValue){<p class="text-muted">Submitted @CropCare.Web.Models.SensorDates.Format(Model.Status.SubmittedAtMs.Value)</p>}<p>Submitting a receipt does not activate Pro. The CropCare team must verify it.</p><a class="btn btn-light" asp-controller="Settings" asp-action="Index">Back to Settings</a></section><section class="cc-card"><h2>Manual receipt review</h2>@if(state=="pro"){<div class="alert alert-success">Your approved Pro subscription is active.</div><p>Review assessments and their stated limitations from your farm zones.</p>}else if(state=="pending"){<div class="alert alert-info">Your receipt is pending manual verification.</div>}else if(state is "free" or "rejected"){<p>Use only payment instructions confirmed directly by the CropCare project team. This website does not process payments. Never enter a GCash PIN, OTP or password.</p><form class="cc-auth-form" asp-action="Submit" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div><label asp-for="ReferenceNumber" class="form-label">GCash reference number</label><input asp-for="ReferenceNumber" class="form-control" inputmode="numeric" maxlength="20" pattern="[0-9]{8,20}" autocomplete="off" /><span asp-validation-for="ReferenceNumber" class="text-danger"></span></div><button class="btn btn-success" type="submit">Submit for Manual Verification</button></form>}else{<div class="alert alert-warning">Membership could not be verified. Submission is unavailable.</div><a class="btn btn-light" asp-action="Index">Retry</a>}</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
