@model CropCare.Web.Models.MonitoringHistoryViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Soil Reading History";
    var selected = CropCare.Web.Models.MonitoringMetrics.All[Model.Metric];
    var sensorId = Model.Sensor.SensorId;
    var records = Model.History.Readings;
    string Print(double? value) => value.HasValue ? value.Value.ToString("0.##") : "—";
    // Only chart the retrieved API page; don't claim to show all Firestore history.
    string chartJson = JsonSerializer.Serialize(records.Select(r => new
    {
        time = r.RecordedAtMs,
        value = CropCare.Web.Models.MonitoringMetrics.Value(r, Model.Metric)
    }));
}
<div class="py-4">
    <a asp-action="Index" class="text-success text-decoration-none">&larr; Back to Soil Monitoring</a>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-3 mb-3">
        <div>
            <h1 class="fw-bold text-success mb-1">Sensor History &amp; Graphs</h1>
            <p class="text-muted mb-0">@Model.Sensor.SensorName — @Model.Sensor.DeviceId</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(sensorId))
        {
            <a asp-controller="Sensors" asp-action="Details" asp-route-id="@sensorId" class="btn btn-outline-success">Sensor details</a>
        }
    </div>
    <div class="alert alert-info" role="note">
        Showing up to 50 saved readings per page, newest first. The graph and date filter apply
        <strong>only to the current page</strong>. Click <strong>Older readings</strong> to review previous pages.
        Past values are historical records, not proof of an online device.
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-warning" role="alert">@Model.Error</div>
    }

    <form asp-action="History" method="get" class="row g-3 align-items-end mb-4">
        <input type="hidden" name="id" value="@sensorId" />
        <input type="hidden" name="cursor" value="@Model.Cursor" />
        <div class="col-12 col-md-5">
            <label for="metric" class="form-label fw-semibold">Measurement to graph</label>
            <select name="metric" id="metric" class="form-select">
                @foreach (var metric in CropCare.Web.Models.MonitoringMetrics.All)
                {
                    if (metric.Key == Model.Metric)
                    {
                        <option value="@metric.Key" selected>@metric.Value.Label (@metric.Value.Unit)</option>
                    }
                    else
                    {
                        <option value="@metric.Key">@metric.Value.Label (@metric.Value.Unit)</option>
                    }
                }
            </select>
        </div>
        <div class="col-12 col-md-auto">
            <button class="btn btn-success w-100" type="submit">Show graph</button>
        </div>
    </form>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <h2 class="h5 fw-bold text-success">@selected.Label trend</h2>
            <p class="text-muted small">Unit: @selected.Unit. Values plotted in chronological order from this page.</p>
            <label for="historyDate" class="form-label fw-semibold">Filter this page by date (Philippine time)</label>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <input type="date" id="historyDate" class="form-control" style="max-width: 220px" />
                <button type="button" class="btn btn-outline-secondary" id="clearHistoryDate">Clear date</button>
            </div>
            <div id="soilChart"
                 data-points="@chartJson"
                 data-label="@selected.Label"
                 data-unit="@selected.Unit"
                 class="border rounded-3 p-2 bg-white"
                 role="img"
                 aria-label="Historical @selected.Label chart for the current page">
            </div>
            <p class="text-muted small mt-2 mb-0" id="chartStatus" aria-live="polite"></p>
        </div>
    </div>

    <h2 class="h5 fw-bold text-success">Recorded measurements</h2>
    @if (records.Count == 0)
    {
        <div class="alert alert-secondary">This sensor has no saved readings on the selected page.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0" id="monitoringHistoryTable">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Recorded (PH)</th>
                            <th scope="col">N (mg/kg)</th>
                            <th scope="col">P (mg/kg)</th>
                            <th scope="col">K (mg/kg)</th>
                            <th scope="col">pH</th>
                            <th scope="col">EC (stored)</th>
                            <th scope="col">Moisture (%)</th>
                            <th scope="col">Temperature (°C)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reading in records)
                        {
                            var phDate = CropCare.Web.Models.ZoneDates.FromUnixMilliseconds(reading.RecordedAtMs);
                            <tr data-reading-date="@(phDate?.ToString("yyyy-MM-dd") ?? "")">
                                <td class="text-nowrap">@reading.RecordedText</td>
                                <td>@Print(reading.Nitrogen)</td>
                                <td>@Print(reading.Phosphorus)</td>
                                <td>@Print(reading.Potassium)</td>
                                <td>@Print(reading.Ph)</td>
                                <td>@Print(reading.Ec)</td>
                                <td>@Print(reading.Moisture)</td>
                                <td>@Print(reading.Temperature)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="small text-muted mt-2" id="historyCount">@records.Count readings on this page</p>
    }
    <div class="d-flex flex-wrap gap-2 justify-content-between mt-3">
        <a asp-action="History" asp-route-id="@sensorId" asp-route-metric="@Model.Metric"
           class="btn btn-outline-success">Newest page</a>
        @if (!string.IsNullOrWhiteSpace(Model.History.NextCursor))
        {
            <a asp-action="History" asp-route-id="@sensorId" asp-route-metric="@Model.Metric"
               asp-route-cursor="@Model.History.NextCursor"
               class="btn btn-success">Older readings &rarr;</a>
        }
    </div>
</div>
@section Scripts {
    <script src="~/js/monitoring-chart.js" asp-append-version="true"></script>
}