@model CropCare.Web.Models.NewRecoveryPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }
<h1>Reset Password</h1><p class="text-muted">Choose a new password for your CropCare account.</p>
<form class="cc-auth-form" asp-action="Reset" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div><label asp-for="NewPassword" class="form-label">New password</label><div class="cc-password"><input asp-for="NewPassword" class="form-control" autocomplete="new-password" maxlength="128" /><button type="button" data-password-toggle="NewPassword" aria-pressed="false">Show</button></div><span asp-validation-for="NewPassword" class="text-danger"></span></div><div><label asp-for="ConfirmPassword" class="form-label">Confirm new password</label><div class="cc-password"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" maxlength="128" /><button type="button" data-password-toggle="ConfirmPassword" aria-pressed="false">Show</button></div><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><small class="text-muted">Use 8–128 characters. Recovery authorization is single-use.</small><button class="btn btn-success" type="submit">Save Password</button></form><a class="cc-back-link" asp-controller="Account" asp-action="Login">Back to Sign In</a>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
