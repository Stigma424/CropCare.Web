@{
    ViewData["Title"] = "Password Updated";
}
<div class="row justify-content-center py-4 py-lg-5">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5 text-center">
                <h1 class="h3 fw-bold text-success">Password Updated!</h1>
                <p class="text-muted">Your CropCare password has been updated. Sign in again with the new password.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-success w-100">Go to Login</a>
            </div>
        </div>
    </div>
</div>