@model CropCare.Web.Models.VerifyRecoveryCodeViewModel
@{ ViewData["Title"] = "Verification"; }
<h1>Verification</h1><p class="text-muted">Check your email and enter the six-digit recovery code.</p>
@if(TempData["RecoveryMessage"] is string message){<div class="alert alert-info">@message</div>}
<form class="cc-auth-form" asp-action="Verify" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div><label asp-for="Code" class="form-label">Verification code</label><input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" /><span asp-validation-for="Code" class="text-danger"></span></div><button class="btn btn-success" type="submit">Submit</button></form><a class="cc-back-link" asp-action="Request">Request another code</a><p class="small text-muted mt-3">Codes expire after five minutes. Never share your recovery code.</p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
