@model CropCare.Web.Models.RequestRecoveryCodeViewModel
@{ ViewData["Title"] = "Forgot Password"; }
<h1>Forgot Password?</h1><p class="text-muted">Enter the email address registered with your CropCare account.</p>
@if(TempData["RecoveryError"] is string error){<div class="alert alert-warning" role="alert">@error</div>}
<form class="cc-auth-form" asp-action="Request" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div><button class="btn btn-success" type="submit">Request Password Reset</button></form><a class="cc-back-link" asp-controller="Account" asp-action="Login">← Back to Sign In</a>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
