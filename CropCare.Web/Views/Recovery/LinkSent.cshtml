@{ ViewData["Title"] = "Check your email"; }
<h1>Check your email</h1>
<p>If this email is registered, a password-reset link will be sent. Check your inbox and spam folder.</p>
<p>Open the link to choose a new password, then return to CropCare and sign in. You do not need to enter a six-digit code for this method.</p>
<a class="btn btn-success" asp-controller="Account" asp-action="Login">Back to Sign In</a>
<a class="cc-back-link" asp-action="Request">Request another link</a>
