@model CropCare.Web.Models.CropCareDashboardViewModel
@{ var hour = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(8)).Hour; var greeting = hour < 12 ? "Good Morning" : hour < 18 ? "Good Afternoon" : "Good Evening"; ViewData["Title"] = $"{greeting}, {Model.Profile?.FirstName ?? User.Identity?.Name ?? "Farmer"}"; }
@if(!string.IsNullOrWhiteSpace(Model.Error)){<div class="alert alert-warning" role="alert">@Model.Error <a asp-action="Index">Retry</a></div>}
<div class="cc-section-heading cc-dashboard-heading"><h2>My Zones</h2><span class="badge bg-success">@Model.Zones.Count(x => !x.Zone.IsHarvested) active</span><div class="cc-zone-tabs" aria-label="Filter farm zones"><button type="button" class="active" data-zone-filter="" aria-pressed="true">All zones</button>@foreach(var item in Model.Zones){<button type="button" data-zone-filter="@item.Zone.ZoneId" aria-pressed="false">@item.Zone.ZoneName</button>}</div></div>
@if(Model.Zones.Count==0){<div class="cc-empty"><h3>@(Model.Error is null ? "No farm zones yet" : "Zones could not be loaded")</h3>@if(Model.Error is null){<p>Create your first zone to begin monitoring your corn field.</p><a class="btn btn-success" asp-controller="Zones" asp-action="Create">+ Add Zone</a>}</div>}
<div class="cc-grid cc-dashboard-grid">@foreach(var item in Model.Zones){<article class="cc-card cc-zone-card" data-zone-card="@item.Zone.ZoneId"><div class="cc-section-heading"><h3>@item.Zone.ZoneName</h3><a asp-action="Index" class="small" aria-label="Refresh zone readings">⟳ refresh</a></div><p class="cc-updated">As of @item.Averages.UpdatedText</p>@if(item.Incomplete){<div class="alert alert-warning small">Some readings are unavailable. @item.Error</div>}
@foreach(var metric in new[]{("N",item.Averages.Nitrogen),("P",item.Averages.Phosphorus),("K",item.Averages.Potassium)}){<div class="cc-reading"><strong>@metric.Item1</strong><strong>@(metric.Item2?.ToString("0.#") ?? "—") @(metric.Item2.HasValue ? "mg/kg" : "")</strong><span class="badge @(metric.Item2.HasValue ? "bg-success" : "bg-secondary")">@(ReadingStatus.Label(metric.Item1, metric.Item2))</span></div>}
<div class="cc-zone-footer"><div><strong>Soil Health @(item.PrototypeSoilHealth?.ToString() ?? "—")@(item.PrototypeSoilHealth.HasValue ? "%" : "")</strong><small class="text-muted">Provisional snapshot · @item.Zone.CropAgeText</small></div><a asp-controller="Zones" asp-action="Details" asp-route-id="@item.Zone.ZoneId">view more ›</a></div><p class="cc-updated mt-3 mb-0">@item.Averages.ContributingSensors of @item.Averages.RegisteredSensors sensors with measurements. @item.MonitoringSummary.</p></article>}</div>

