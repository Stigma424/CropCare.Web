@model CropCare.Web.Models.CropCareDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="py-4">

    <!-- DASHBOARD HEADER -->

    <div class="d-flex flex-wrap
                align-items-center
                justify-content-between
                gap-3 mb-4">

        <div>
            <h1 class="fw-bold text-success mb-1">
                CropCare Dashboard
            </h1>

            <p class="text-muted mb-0">
                Welcome,
                @(Model.Profile?.FirstName
                                ?? User.Identity?.Name
                                ?? "Farmer").

                Monitor your corn zones below.
            </p>
        </div>

        <a asp-controller="Zones"
           asp-action="Create"
           class="btn btn-success">
            + Add Zone
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-warning">
            @Model.Error
        </div>
    }

    <!-- DASHBOARD SUMMARY -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="small text-muted">
                        Farm Zones
                    </div>

                    <div class="fs-3 fw-bold text-success">
                        @Model.Zones.Count
                    </div>

                    <a asp-controller="Zones"
                       asp-action="Index"
                       class="small text-success">
                        See all zones
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <h2 class="h6 text-success
                                   fw-bold mb-0">
                            Overall Soil Health
                        </h2>

                        <span class="badge bg-secondary">
                            Pending
                        </span>
                    </div>

                    <p class="fs-5 mt-2 mb-1">
                        Overall farm scoring is in development.
                    </p>

                    <p class="small text-muted mb-0">
                        Use zone recommendations to view
                        each zone's provisional condition score.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- FARM ZONES -->

    <div class="d-flex flex-wrap
                justify-content-between
                align-items-center gap-2 mb-3">

        <h2 class="h4 fw-bold text-success mb-0">
            My Farm Zones
        </h2>

        <a asp-controller="Zones"
           asp-action="Index"
           class="text-success">
            Manage all zones &rarr;
        </a>
    </div>

    @if (Model.Zones.Count == 0)
    {
        <div class="alert alert-secondary">
            No farm zones loaded yet.
            Create a zone to begin.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var item in Model.Zones)
            {
                <div class="col-12 col-xl-6">

                    <div class="card border-0 shadow-sm
                                        rounded-4 h-100">

                        <div class="card-body p-3 p-md-4
                                            d-flex flex-column">

                            <div class="d-flex flex-wrap
                                                justify-content-between
                                                gap-2 mb-3">

                                <div>
                                    <h3 class="h5 fw-bold
                                                       text-success mb-1">
                                        @item.Zone.ZoneName
                                    </h3>

                                    <div class="small text-muted">
                                        @item.Zone.CropAgeText
                                        ·
                                        @item.Zone.ZoneAreaSqm.ToString("N0") m²
                                    </div>
                                </div>

                                <span class="badge align-self-start
                                                     @(item.Zone.IsHarvested ? "bg-secondary" : "bg-success")">
                                    @(item.Zone.IsHarvested ? "Harvested" : "Planted")
                                </span>
                            </div>

                            <!-- Existing sensor metrics -->
                            <partial name="_ZoneMetrics"
                                     model="item" />

                            <div class="mt-auto pt-3">

                                @if (item.IsSubscribed == true)
                                {
                                    <button type="button"
                                            class="btn btn-success w-100 mb-2"
                                            data-bs-toggle="modal"
                                            data-bs-target="#zoneRecommendationModal"
                                            data-recommendation-url="@Url.Action("Popup", "Advisories", new { zoneId = item.Zone.ZoneId })">
                                        View Recommendations
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Subscription"
                                       asp-action="Index"
                                       class="btn btn-outline-success
                                                          w-100 mb-2">
                                        Unlock Recommendations (Pro)
                                    </a>
                                }

                                <a asp-controller="Zones"
                                   asp-action="Details"
                                   asp-route-id="@item.Zone.ZoneId"
                                   class="btn btn-outline-success w-100">

                                    View Zone Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Shared popup used by all dashboard zone cards -->
<partial name="_ZoneRecommendationModal" />
