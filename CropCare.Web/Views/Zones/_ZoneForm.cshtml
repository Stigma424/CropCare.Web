@model CropCare.Web.Models.ZoneFormViewModel
@{ var action = ViewData["FormAction"]?.ToString() ?? "Create"; }
<form asp-action="@action" asp-route-id="@Model.ZoneId" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="alert alert-warning" role="alert"></div><div class="cc-grid"><section class="cc-card cc-stack"><h2>Zone information</h2><div><label asp-for="ZoneName" class="form-label"></label><input asp-for="ZoneName" class="form-control" maxlength="80" /><span asp-validation-for="ZoneName" class="text-danger"></span></div><div><label asp-for="ZoneAreaSqm" class="form-label">Area (square meters)</label><input asp-for="ZoneAreaSqm" class="form-control" type="number" step="any" min="0.000001" max="100000000" /><span asp-validation-for="ZoneAreaSqm" class="text-danger"></span></div><div class="cc-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-success" type="submit">@(action=="Create" ? "Add Zone" : "Save Changes")</button></div></section><section class="cc-card"><h2>Planting date</h2><label asp-for="PlantingDate" class="form-label"></label><input asp-for="PlantingDate" class="form-control" type="date" min="1970-01-02" max="2099-12-31" /><span asp-validation-for="PlantingDate" class="text-danger"></span><div class="cc-calendar mt-4" data-calendar-for="PlantingDate"><div class="cc-section-heading"><button class="btn btn-light btn-sm" type="button" data-cal-step="-1" aria-label="Previous month">‹</button><strong data-cal-title></strong><button class="btn btn-light btn-sm" type="button" data-cal-step="1" aria-label="Next month">›</button></div><div class="cc-cal-days" data-cal-days></div></div></section></div></form>
