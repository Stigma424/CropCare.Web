@model List<CropCare.Web.Models.ZoneRecord>
@{
    ViewData["Title"] = "Farm Zones";
    var activeCount = Model.Count(z => !z.IsHarvested);
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-success mb-1">My Farm Zones</h1>
            <p class="text-muted mb-0">Organize corn-growing areas and planting cycles.</p>
        </div>
        <a asp-controller="Zones" asp-action="Create" class="btn btn-success btn-lg">+ Add Zone</a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (ViewBag.Error is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total zones</div>
                    <div class="fs-2 fw-bold text-success">@Model.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Not harvested</div>
                    <div class="fs-2 fw-bold text-success">@activeCount</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Harvested</div>
                    <div class="fs-2 fw-bold">@(Model.Count - activeCount)</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <h2 class="h4">No zones to display</h2>
                <p class="text-muted">Add your first zone to begin managing your corn field.</p>
                <a asp-action="Create" class="btn btn-success">Add Your First Zone</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var zone in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 rounded-4">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between gap-2 align-items-start">
                                <h2 class="h5 fw-bold text-success">@zone.ZoneName</h2>
                                <span class="badge @(zone.IsHarvested ? "bg-secondary" : "bg-success")">
                                    @(zone.IsHarvested ? "Harvested" : "Not harvested")
                                </span>
                            </div>
                            <dl class="row small mt-3 mb-3">
                                <dt class="col-5 text-muted">Area</dt>
                                <dd class="col-7">@zone.ZoneAreaSqm.ToString("N2") m²</dd>
                                <dt class="col-5 text-muted">Planting date</dt>
                                <dd class="col-7">@zone.PlantingDateText</dd>
                                <dt class="col-5 text-muted">Corn age</dt>
                                <dd class="col-7">@zone.CropAgeText</dd>
                            </dl>
                            <a asp-action="Details" asp-route-id="@zone.ZoneId"
                               class="btn btn-outline-success mt-auto">View Zone Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>