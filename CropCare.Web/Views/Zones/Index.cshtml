@model List<CropCare.Web.Models.ZoneRecord>
@{ ViewData["Title"] = "My Zones"; }
<div class="cc-section-heading"><h2>Farm zones</h2><a class="btn btn-success" asp-action="Create">+ Add Zone</a></div>
@if(ViewBag.Error is string error){<div class="alert alert-warning">@error</div>}else if(Model.Count==0){<div class="cc-empty">No zones yet. Add a zone to begin monitoring.</div>}
<div class="cc-grid">@foreach(var zone in Model){<article class="cc-card"><h3>@zone.ZoneName</h3><p class="text-muted">@zone.ZoneAreaSqm.ToString("N0") m² · @zone.CropAgeText</p><div class="cc-actions"><a class="btn btn-success" asp-action="Details" asp-route-id="@zone.ZoneId">View Zone</a><a class="btn btn-light" asp-action="Edit" asp-route-id="@zone.ZoneId">Edit</a></div></article>}</div>
