@model CropCare.Web.Models.ZoneOverview

@{
    ViewData["Title"] = Model.Zone.ZoneName;

    var zone = Model.Zone;

    var defaultPlantingDate =
        CropCare.Web.Models.ZoneDates.Today
            .ToString("yyyy-MM-dd");

    bool isPro = Model.IsSubscribed == true;
}

<div class="py-4">

    <a asp-action="Index"
       class="text-success text-decoration-none">
        &larr; Back to My Zones
    </a>

    <div class="d-flex flex-wrap
                justify-content-between align-items-start
                gap-3 mt-3 mb-4">

        <div>
            <h1 class="fw-bold text-success mb-1">
                @zone.ZoneName
            </h1>

            <span class="badge @(zone.IsHarvested ? "bg-secondary" : "bg-success")">
                @(zone.IsHarvested ? "Harvested" : "Growing")
            </span>
        </div>

        <div class="d-flex flex-wrap gap-2">

            @if (isPro)
            {
                <button type="button"
                        class="btn btn-success"
                        data-bs-toggle="modal"
                        data-bs-target="#zoneRecommendationModal"
                        data-recommendation-url="@Url.Action("Popup", "Advisories", new { zoneId = zone.ZoneId })">
                    View Recommendations
                </button>
            }
            else
            {
                <a asp-controller="Subscription"
                   asp-action="Index"
                   class="btn btn-success">
                    Unlock Recommendations (Pro)
                </a>
            }

            <a asp-action="Edit"
               asp-route-id="@zone.ZoneId"
               class="btn btn-outline-success">
                Edit Zone
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">
            @success
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-warning">
            @Model.Error
        </div>
    }

    <div class="row g-3">

        <!-- ZONE INFORMATION -->

        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h2 class="h5 text-success fw-bold">
                        Zone Information
                    </h2>

                    <dl class="row mb-0">

                        <dt class="col-5">Area</dt>
                        <dd class="col-7">
                            @zone.ZoneAreaSqm.ToString("N2") m²
                        </dd>

                        <dt class="col-5">Planting date</dt>
                        <dd class="col-7">
                            @zone.PlantingDateText
                        </dd>

                        <dt class="col-5">Corn status</dt>
                        <dd class="col-7">
                            @zone.CropAgeText
                        </dd>

                    </dl>
                </div>
            </div>
        </div>

        <!-- PLANTING AND HARVEST -->

        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h2 class="h5 text-success fw-bold">
                        Planting / Harvest
                    </h2>

                    @if (!zone.IsHarvested)
                    {
                        <p class="small text-muted">
                            Mark this zone harvested when its
                            current corn crop is finished.
                        </p>

                        <form asp-action="Harvest"
                              asp-route-id="@zone.ZoneId"
                              method="post"
                              asp-antiforgery="true"
                              onsubmit="return confirm('Mark zone as harvested?');">

                            <button class="btn btn-success w-100"
                                    type="submit">
                                Mark Harvested
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="small text-muted">
                            Start a new corn planting cycle.
                        </p>

                        <form asp-action="Replant"
                              asp-route-id="@zone.ZoneId"
                              method="post"
                              asp-antiforgery="true"
                              onsubmit="return confirm('Start new planting?');">

                            <label for="plantingDate"
                                   class="form-label">
                                Planting date
                            </label>

                            <input id="plantingDate"
                                   name="plantingDate"
                                   class="form-control mb-2"
                                   type="date"
                                   value="@defaultPlantingDate"
                                   required />

                            <button class="btn btn-success w-100"
                                    type="submit">
                                New Corn Planted
                            </button>
                        </form>
                    }

                    <p class="small text-muted mt-2 mb-0">
                        Previous planting cycles are not
                        archived separately in the current API.
                    </p>
                </div>
            </div>
        </div>

        <!-- SOIL READINGS -->

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3 p-md-4">

                    <h2 class="h5 fw-bold text-success mb-3">
                        Average Soil Readings
                    </h2>

                    <partial name="_ZoneMetrics" model="Model" />

                </div>
            </div>
        </div>

        <!-- RECOMMENDATION ACCESS -->

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <div class="d-flex flex-wrap
                                justify-content-between
                                align-items-center gap-3">

                        <div>
                            <h2 class="h5 fw-bold text-success mb-1">
                                CropCare Recommendations
                            </h2>

                            <p class="small text-muted mb-0">
                                View a short summary of soil conditions
                                and suggested actions for this zone.
                            </p>
                        </div>

                        @if (isPro)
                        {
                            <button type="button"
                                    class="btn btn-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#zoneRecommendationModal"
                                    data-recommendation-url="@Url.Action("Popup", "Advisories", new { zoneId = zone.ZoneId })">
                                Show Recommendations
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Subscription"
                               asp-action="Index"
                               class="btn btn-outline-success">
                                View Pro Plans
                            </a>
                        }
                    </div>

                    @if (isPro)
                    {
                        <div class="mt-3">
                            <a asp-controller="Advisories"
                               asp-action="Index"
                               asp-route-zoneId="@zone.ZoneId"
                               class="small text-success">

                                Historical assessment (debugging)
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SENSOR MANAGEMENT -->

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <div class="d-flex flex-wrap
                                justify-content-between
                                align-items-center gap-2">

                        <div>
                            <h2 class="h5 fw-bold text-success mb-1">
                                Sensors for this Zone
                            </h2>

                            <p class="text-muted small mb-0">
                                @Model.Sensors.Count registered sensor(s).
                            </p>
                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <a asp-controller="Sensors"
                               asp-action="Index"
                               asp-route-zoneId="@zone.ZoneId"
                               class="btn btn-success">
                                View Zone Sensors &rarr;
                            </a>

                            <a asp-controller="Sensors"
                               asp-action="Pair"
                               asp-route-zoneId="@zone.ZoneId"
                               class="btn btn-outline-success">
                                + Pair Sensor QR
                            </a>
                        </div>
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        QR pairing requires a device
                        pre-registered in Firestore.
                        Removing a paired device does not
                        automatically reset its QR claim.
                    </p>
                </div>
            </div>
        </div>

        <!-- DELETE ZONE -->

        <div class="col-12">
            <div class="card border-danger rounded-4">
                <div class="card-body p-4">

                    <h2 class="h6 fw-bold text-danger">
                        Delete Zone
                    </h2>

                    <p class="small text-muted">
                        Remove registered sensors before
                        deleting this zone.
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@zone.ZoneId"
                          method="post"
                          asp-antiforgery="true"
                          onsubmit="return confirm('Permanently delete this zone?');">

                        <button type="submit"
                                class="btn btn-outline-danger">
                            Delete Zone
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Only one modal per page -->
<partial name="_ZoneRecommendationModal" />
