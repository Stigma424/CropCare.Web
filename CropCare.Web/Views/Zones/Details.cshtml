@model CropCare.Web.Models.ZoneOverview
@{ ViewData["Title"] = "ZONE MANAGEMENT / " + Model.Zone.ZoneName; ViewData["Subtitle"] = "As of " + Model.Averages.UpdatedText; var a = Model.Averages; string Value(double? n,string unit="") => n.HasValue ? n.Value.ToString("0.#") + unit : "—"; }
<div class="cc-section-heading"><h2 class="text-success">@Model.Zone.ZoneName</h2><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Zone.ZoneId">⟳ Refresh</a></div>
@if(Model.Error is not null || Model.Incomplete){<div class="alert alert-warning">@(Model.Error ?? "Some sensor measurements are unavailable. Displayed averages may be incomplete.")</div>}
<div class="cc-grid cc-zone-detail"><div class="cc-stack"><section class="cc-card"><h3>Corn Age</h3><div class="cc-option"><strong>@(Model.Zone.IsHarvested ? "Harvested" : "Planting cycle")</strong><span>@Model.Zone.CropAgeText</span></div><p class="small text-muted mt-3 mb-0">@Model.Zone.ZoneAreaSqm.ToString("N0") m² · planted @Model.Zone.PlantingDateText</p></section>
<section class="cc-card"><h3>Other Details</h3>@foreach(var metric in new[]{("Moisture",Value(a.Moisture,"%")),("pH Level",Value(a.Ph)),("Temperature",Value(a.Temperature,"°C")),("Electrical Conductivity",Value(a.Ec," (stored units)"))}){<div class="cc-details-row"><span>@metric.Item1</span><strong>@metric.Item2</strong></div>}<p class="small text-muted">@a.ContributingSensors of @a.RegisteredSensors sensors with measurements. @Model.MonitoringSummary.</p></section>
<section class="cc-card"><h3>Soil Health</h3><div class="cc-details-row"><span>Provisional snapshot</span><strong>@(Model.PrototypeSoilHealth.HasValue ? $"{Model.PrototypeSoilHealth}%" : "Not available")</strong></div><p class="small text-muted mb-0">Current prototype score, not a validated sustainability or fertilization-efficiency score.</p></section></div>
<div class="cc-stack"><section class="cc-card cc-stack"><h3>NPK Readings</h3>@foreach(var metric in new[]{("N","Nitrogen",a.Nitrogen,""),("P","Phosphorus",a.Phosphorus,"p"),("K","Potassium",a.Potassium,"k")}){<div class="cc-nutrient"><span class="cc-nutrient-badge @metric.Item4">@metric.Item1</span><div><small>@metric.Item2.ToUpperInvariant()</small><strong>@Value(metric.Item3," mg/kg")</strong></div><span class="badge @(ReadingStatus.Label(metric.Item1, metric.Item3) == "GOOD" ? "bg-success" : metric.Item3.HasValue ? "bg-danger" : "bg-secondary")">@(ReadingStatus.Label(metric.Item1, metric.Item3))</span></div>}</section>
<section class="cc-card"><h3>Recommendations</h3><div class="cc-recommendation">@if(Model.Zone.IsHarvested){<p class="mb-0">The crop is harvested. Start a new planting cycle to request crop recommendations.</p>}else if(Model.IsSubscribed==true){<p>View the current server assessment, its limitations and reference information.</p><button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#zoneRecommendationModal" data-recommendation-url="@Url.Action("Popup","Advisories",new{zoneId=Model.Zone.ZoneId})">View Recommendations</button><a class="btn btn-light ms-2" href="@Url.Action("Current","Advisories",new{zoneId=Model.Zone.ZoneId})">Open full page</a>}else if(Model.IsSubscribed==false){<p>Detailed recommendations require an approved Pro subscription.</p><a class="btn btn-light" asp-controller="Subscription" asp-action="Index">View Subscription</a>}else{<p class="mb-0">Subscription status is unavailable. Refresh to retry.</p>}</div></section>
<div class="cc-actions"><a class="btn btn-success" asp-controller="Sensors" asp-action="Index" asp-route-zoneId="@Model.Zone.ZoneId">Sensor Status</a><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Zone.ZoneId">Edit</a><form asp-action="Delete" asp-route-id="@Model.Zone.ZoneId" method="post" asp-antiforgery="true" data-confirm="Delete this zone? Its registered sensors must be removed first. Historical readings are retained."><button class="btn btn-danger" type="submit">Delete</button></form><a class="btn btn-light" asp-controller="Dashboard" asp-action="Index">← Back</a></div>
@if(Model.Zone.IsHarvested){<form class="cc-card" asp-action="Replant" asp-route-id="@Model.Zone.ZoneId" method="post" asp-antiforgery="true"><label class="form-label" for="plantingDate">New planting date</label><input class="form-control mb-3" type="date" id="plantingDate" name="plantingDate" min="1970-01-02" max="2099-12-31" value="@CropCare.Web.Models.ZoneDates.Today.ToString("yyyy-MM-dd")" required /><button class="btn btn-warning" type="submit">New Corn Planted</button></form>}else{<form asp-action="Harvest" asp-route-id="@Model.Zone.ZoneId" method="post" asp-antiforgery="true" data-confirm="Mark this planting cycle as harvested?"><button class="btn btn-warning" type="submit">Mark Harvested</button></form>}</div></div>
<partial name="_ZoneRecommendationModal" />


