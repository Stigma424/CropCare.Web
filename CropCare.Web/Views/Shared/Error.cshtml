@model CropCare.Web.Models.ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="cc-card"><h2>We could not complete this request</h2><p>Please try again. If the problem continues, contact the CropCare project team.</p><p class="text-muted">Request reference: @Model?.RequestId</p><a class="btn btn-success" asp-controller="Dashboard" asp-action="Index">Back to Home</a></section>
