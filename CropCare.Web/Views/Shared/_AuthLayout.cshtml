<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · CropCare</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<main class="cc-auth"><aside class="cc-auth-brand" aria-label="CropCare"><h1>CROPCARE</h1><p>SMART FARMING</p><div class="cc-auth-divider"></div><div class="cc-auth-hero"><strong>CROPCARE</strong><span>SMART FARMING</span></div></aside>
<section class="cc-auth-main"><div class="cc-auth-card">@foreach(var key in new[]{"Error","Notice"}) { if(TempData[key] is string message) { <div class="alert @(key=="Error" ? "alert-warning" : "alert-success")" role="status">@message</div> } }@RenderBody()</div></section></main>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
