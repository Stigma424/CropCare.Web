@model CropCare.Web.Models.ZoneOverview
@{
    var a = Model.Averages;
    string Metric(double? n, string suffix, string format = "0.#") =>
        n.HasValue ? n.Value.ToString(format) + suffix : "—";
    var values = new (string Label, string Value)[]
    {
        ("Nitrogen", Metric(a.Nitrogen, " mg/kg", "0")),
        ("Phosphorus", Metric(a.Phosphorus, " mg/kg", "0")),
        ("Potassium", Metric(a.Potassium, " mg/kg", "0")),
        ("Moisture", Metric(a.Moisture, "%", "0")),
        ("pH", Metric(a.Ph, "", "0.0")),
        ("Soil temperature", Metric(a.Temperature, " °C", "0.#")),
        ("EC", Metric(a.Ec, " (stored units)", "0.#"))
    };
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-warning small py-2" role="alert">@Model.Error</div>
}
<div class="d-flex justify-content-between flex-wrap gap-2 mb-2">
    <span class="small text-muted">Latest reading from each sensor, averaged per parameter</span>
    <span class="small text-muted">@a.ContributingSensors of @a.RegisteredSensors sensor(s) with readings</span>
</div>
@if (a.HasData)
{
    <p class="small text-muted mb-3">Most recent: @a.UpdatedText. Saved data may be historical, not live.</p>
    <div class="row row-cols-2 row-cols-md-3 g-2 mb-3">
        @foreach (var metric in values)
        {
            <div class="col">
                <div class="border bg-light rounded-3 p-2 h-100">
                    <div class="small text-muted">@metric.Label</div>
                    <div class="fw-semibold text-success">@metric.Value</div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-secondary small">No saved readings are available for this zone yet.</div>
}
<div class="row g-2 mt-1">
    <div class="col-12 col-lg-5">
        <div class="border rounded-3 p-3 h-100">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <h3 class="h6 mb-0 text-success">Soil Health</h3>
                <span class="badge bg-secondary">Prototype</span>
            </div>
            <p class="fw-semibold fs-5 mb-1 mt-2">@(Model.PrototypeSoilHealth.HasValue ? $"{Model.PrototypeSoilHealth}%" : "Not available")</p>
            <p class="small text-muted mb-0">@Model.SoilHealthLabel</p>
            <p class="small text-muted mt-2 mb-0">Mobile's five-condition scoring rule. Not validated as a soil-health assessment.</p>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="border rounded-3 p-3 h-100">
            <h3 class="h6 text-success">Fertilizer Recommendation</h3>
            <p class="mb-0 small">@Model.RecommendationText</p>
            <p class="text-muted small mt-2 mb-0">Placeholder only — no fertilizer type or dose is calculated here.</p>
        </div>
    </div>
</div>