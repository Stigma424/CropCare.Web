
<div class="modal fade"
     id="zoneRecommendationModal"
     tabindex="-1"
     aria-label="CropCare zone recommendations"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered
                modal-dialog-scrollable modal-lg">

        <div class="modal-content"
             id="zoneRecommendationContent">

            <div class="modal-header">
                <h2 class="modal-title h5">
                    CropCare Recommendations
                </h2>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                Loading recommendations...
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("zoneRecommendationModal");
        const content = document.getElementById("zoneRecommendationContent");

        if (!modal || !content) return;

        const loadingMarkup = `
            <div class="modal-header">
                <h2 class="modal-title h5">CropCare Recommendations</h2>
                <button class="btn-close" type="button"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="spinner-border text-success" role="status"></div>
                <p class="small text-muted mt-3">Loading recommendations...</p>
            </div>`;

        modal.addEventListener("show.bs.modal", async (event) => {
            const url = event.relatedTarget?.getAttribute(
                "data-recommendation-url");

            content.innerHTML = loadingMarkup;

            if (!url) {
                content.querySelector(".modal-body").textContent =
                    "No zone selected.";
                return;
            }

            try {
                const response = await fetch(url, {
                    credentials: "same-origin",
                    cache: "no-store"
                });

                if (response.status === 403) {
                    content.innerHTML = `
                        <div class="modal-header">
                            <h2 class="modal-title h5">CropCare Pro</h2>
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Upgrade to CropCare Pro to view recommendations.</p>
                            <a class="btn btn-success"
                               href="@Url.Action("Index", "Subscription")">
                                View Subscription
                            </a>
                        </div>`;
                    return;
                }

                if (response.status === 401) {
                    throw new Error("Your session expired. Log in again.");
                }

                if (!response.ok) {
                    throw new Error("The recommendation is unavailable.");
                }

                // HTML is generated by our server-side Razor partial.
                content.innerHTML = await response.text();
            }
            catch (error) {
                content.innerHTML = loadingMarkup;
                const body = content.querySelector(".modal-body");
                body.textContent = error.message ||
                    "Could not load recommendations.";
            }
        });
    });
</script>
