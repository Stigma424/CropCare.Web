<div class="modal fade" id="zoneRecommendationModal" tabindex="-1" aria-label="CropCare recommendations" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg"><div class="modal-content" id="zoneRecommendationContent"><div class="modal-body">Loading recommendations…</div></div></div></div>
<script>
(() => {
    const modal=document.getElementById('zoneRecommendationModal'),content=document.getElementById('zoneRecommendationContent');
    if(!modal||!content) return;
    let pending=null,generation=0;
    const message=text=>{content.replaceChildren();const header=document.createElement('div');header.className='modal-header';const title=document.createElement('h2');title.className='modal-title h5';title.textContent='CropCare Recommendations';const close=document.createElement('button');close.className='btn-close';close.type='button';close.setAttribute('data-bs-dismiss','modal');close.setAttribute('aria-label','Close');header.append(title,close);const body=document.createElement('div');body.className='modal-body';body.textContent=text;content.append(header,body);};
    modal.addEventListener('hidden.bs.modal',()=>{generation++;pending?.abort();});
    async function load(url){
        pending?.abort();pending=new AbortController();const request=++generation;
        message('Loading recommendations…');
        if(!url){message('No zone selected.');return;}
        try{
            const response=await fetch(url,{credentials:'same-origin',cache:'no-store',signal:pending.signal,headers:{'X-CropCare-Partial':'true'}});
            if(request!==generation)return;
            if(response.status===401||response.redirected){message('Your session expired. Sign in again.');const link=document.createElement('a');link.href='@Url.Action("Login","Account")';link.textContent='Sign in';link.className='btn btn-success mt-3';content.querySelector('.modal-body').append(document.createElement('br'),link);return;}
            if(response.status===403){message('An approved Pro subscription is required.');return;}
            if(!response.ok)throw new Error('The assessment is currently unavailable. Please try again.');
            const html=await response.text();if(request===generation)content.innerHTML=html;
        }catch(error){if(error.name!=='AbortError'&&request===generation)message(error.message||'Assessment unavailable.');}
    }
    modal.addEventListener('show.bs.modal',event=>load(event.relatedTarget?.getAttribute('data-recommendation-url')));
    modal.addEventListener('change',event=>{const target=event.target;if(target.matches('[data-assessment-program]'))load('/Advisories/Popup?zoneId='+encodeURIComponent(target.dataset.zoneId)+'&programId='+encodeURIComponent(target.value));});
})();
</script>
