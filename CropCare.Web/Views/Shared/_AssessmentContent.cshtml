@model CropCare.Web.Models.ZoneAssessmentDto
@{
    var sensorId = ViewData["RecommendationSensorId"] as string;
    var summary = new CropCare.Web.Models.RecommendationSummary(Model);
    var detailsId = "advice-" + Guid.NewGuid().ToString("N");
}
<div class="cc-advisory" data-assessment-status="@Model.AssessmentStatus">
<section class="cc-advisory-hero" aria-label="Recommendation summary">
<p class="cc-eyebrow">YOUR NEXT STEP</p>
<h3>@(Model.PrimaryAction?.Title ?? "Waiting for usable readings")</h3>
<p class="cc-advisory-action">@Model.PrimaryAction?.WhatToDo</p>
<p class="cc-advisory-note">Updated @CropCare.Web.Models.SensorDates.Format(Model.EvaluatedAtMs) · Corn program @Model.ProgramId</p>
</section>
<div class="cc-application-grid">
@foreach (var item in new[] { ("What to apply", summary.What), ("How to apply", summary.How), ("When to apply", summary.When), ("How much to apply", summary.Amount) })
{
    <article class="cc-advisory-section cc-action-card @(summary.CanReviewApplication ? "cc-tone-good" : "cc-tone-check")">
    <h4>@item.Item1</h4><ul><li>@item.Item2</li></ul></article>
}
</div>
<p class="cc-advisory-warning"><strong>Application status:</strong> @summary.ApplicationNote</p>
@if(Model.PartialCoverage){<p class="cc-advisory-warning">Partial coverage: some readings are excluded. This assessment does not describe every part of your zone.</p>}
<button type="button" class="btn btn-success cc-more-details" data-advice-toggle aria-expanded="false" aria-controls="@detailsId">View more details</button>
<div id="@detailsId" data-advice-details hidden>
<section class="cc-advisory-section cc-action-card">
<h4>Full application plan</h4>
<p>Published corn program @Model.ProgramId. Reference quantities are scaled to @(sensorId is null ? "your zone area" : $"{Model.SensorAssignedAreaSqm:0.##} m² assigned to this sensor"). Confirm crop stage and account for previous applications.</p>
@if(Model.DisplayPlan.Entries.Count==0){<p class="cc-advisory-warning">No quantities available for this crop cycle. Complete the current zone setup.</p>}
@foreach(var entry in Model.DisplayPlan.Entries){
<article class="cc-advisory-check"><h4>@entry.Product (@entry.FertilizerGrade)</h4><ul><li><strong>@entry.KgForPlot.ToString("0.00") kg for this plot</strong></li><li>When: @entry.ApplicationTiming</li><li>@entry.KgPerHectare kg/ha published program basis</li></ul></article>}
<ul><li>Follow each product label and check root-zone moisture.</li><li>Account for fertilizer already applied this cycle.</li><li>DAE means days after emergence, not planting. Confirm actual crop stage.</li></ul>
</section>
<section class="cc-advisory-section cc-action-card cc-tone-check"><h4>What needs checking</h4>
@foreach(var action in Model.Recommendations){<article class="cc-advisory-check"><h4>@action.Title</h4><ul><li>@action.WhatToDo</li><li>Why: @action.Why</li></ul></article>}
</section>
<section class="cc-advisory-section cc-action-card"><h4>Soil health score</h4>
<div class="cc-advisory-stats"><div><strong>@(Model.SoilHealth.Score.HasValue ? Model.SoilHealth.Score.Value.ToString("0.#")+"/100" : "Not available")</strong><small>@Model.SoilHealth.Label</small></div><div><span>Usable sensors</span><strong>@Model.SoilHealth.ValidSensors / @Model.SensorAllocation.Installed</strong><small>@Model.ExcludedSensors excluded from advice</small></div></div>
<p class="small">Sensor-based condition score. Laboratory testing provides a fuller soil assessment.</p></section>
<section class="cc-advisory-section cc-action-card"><h4>Sensor readings and quality</h4>
@{ var index=0; }
@foreach(var sensor in Model.SensorQuality ?? new()){ index++;
<article class="cc-advisory-check @(sensor.CanUseForScore ? "cc-tone-good" : "cc-tone-alert")"><h4>Sensor @index · @(sensor.CanUseForScore ? "USABLE" : "CHECK REQUIRED")</h4><ul><li>@sensor.Message</li><li>Status: @sensor.Status.Replace('_',' ')</li><li>Device record: @sensor.SensorId</li></ul></article>}
</section>
<section class="cc-advisory-section cc-action-card"><h4>Corn program options</h4>
<p class="small">Choose a published hybrid-corn yield target that matches your plan. This is a target, not a predicted yield.</p>
<div class="cc-program-cards">
@foreach(var option in new[] { ("HYB-1", "5–8 t/ha"), ("HYB-2", "8–12 t/ha") }){
@if (sensorId is null)
{
<button type="button" class="cc-program-card @(Model.ProgramId == option.Item1 ? "active" : "")" data-assessment-program-card data-zone-id="@Model.ZoneId" data-program-id="@option.Item1" aria-pressed="@(Model.ProgramId == option.Item1 ? "true" : "false")"><strong>@option.Item1</strong><span>@option.Item2</span></button>
}
else
{
<a class="cc-program-card @(Model.ProgramId == option.Item1 ? "active" : "")" asp-controller="Sensors" asp-action="Details"
   asp-route-id="@sensorId" asp-route-programId="@option.Item1" asp-fragment="sensor-advice"
   aria-current="@(Model.ProgramId == option.Item1 ? "true" : null)"><strong>@option.Item1</strong><span>@option.Item2</span></a>
}}
</div></section>
<section class="cc-advisory-section cc-action-card"><h4>Sources</h4>
@foreach(var source in Model.EvidenceReferences.Where(s => s.Id is "DA_PHILRICE_CORN_TABLE21" or "CROPCARE_MOISTURE_PROTOTYPE")){
var fertilizer = source.Id == "DA_PHILRICE_CORN_TABLE21";
<article class="cc-advisory-check"><strong>@(fertilizer ? "DA-PhilRice · Hybrid corn fertilizer program (Table 21)" : "University of Minnesota Extension · Soil-moisture monitoring")</strong>
<p>@(fertilizer ? "Published product rates and application timing. Plot quantities are scaled by zone area." : "Guidance on moisture monitoring, soil texture and calibration.")</p>
@if(Uri.TryCreate(source.Url,UriKind.Absolute,out var url) && url.Scheme=="https"){<a href="@url" target="_blank" rel="noopener noreferrer">Read source</a>}</article>}
<p class="small">Reading classifications follow CropCare's configured monitoring bands.</p>
</section>
</div>
</div>
