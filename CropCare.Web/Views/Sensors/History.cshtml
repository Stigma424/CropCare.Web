@model CropCare.Web.Models.SensorHistoryViewModel
@using CropCare.Web.Models
@using System.Text.Json
@{ ViewData["Title"] = (string.IsNullOrWhiteSpace(Model.History.SensorName) ? "Sensor" : Model.History.SensorName) + " history"; var selected=MonitoringMetrics.All[Model.Metric]; var points=JsonSerializer.Serialize(Model.History.Readings.Select(r=>new{time=r.RecordedAtMs,value=MonitoringMetrics.Value(r,Model.Metric)})); string Value(double? n,string unit="") => n.HasValue ? n.Value.ToString("0.##")+unit : "—"; }
<div class="cc-section-heading"><a asp-action="Details" asp-route-id="@Model.SensorId">← Sensor Details</a><a class="btn btn-light" asp-action="History" asp-route-id="@Model.SensorId" asp-route-metric="@Model.Metric">⟳ Refresh</a></div>
@if(Model.Error is not null){<div class="alert alert-warning" role="alert">@Model.Error</div>}
<section class="cc-card cc-section"><h2>Recorded trends</h2><p class="small text-muted">Chart and date filter cover this loaded page only. Dates use Asia/Manila. Past measurements are not proof the device is currently online.</p><form asp-action="History" method="get" class="cc-actions"><input type="hidden" name="id" value="@Model.SensorId" /><label class="form-label" for="metric">Metric</label><select name="metric" id="metric" class="form-select w-auto">@foreach(var m in MonitoringMetrics.All){<option value="@m.Key" selected="@(m.Key==Model.Metric)">@m.Value.Label (@m.Value.Unit)</option>}</select><button class="btn btn-success" type="submit">Show chart</button></form><div class="cc-actions mt-3"><label for="historyDate" class="form-label">Filter page by date</label><input type="date" id="historyDate" class="form-control w-auto" /><button id="clearHistoryDate" class="btn btn-light" type="button">Clear date</button></div><p id="historyCount" class="small text-muted mt-3">@Model.History.Readings.Count readings on this page</p><div id="soilChart" data-points="@points" data-label="@selected.Label" data-unit="@selected.Unit"></div><p id="chartStatus" class="small text-muted" aria-live="polite"></p></section>
@if(Model.History.Readings.Count==0 && Model.Error is null){<div class="cc-empty">No recorded readings on this page.</div>}
<div class="cc-grid">@foreach(var r in Model.History.Readings){<article class="cc-card" data-history-card data-reading-date="@(SensorDates.DayKey(r.RecordedAtMs))"><div class="cc-section-heading"><h3>@r.RecordedText</h3><span class="badge bg-secondary">Recorded</span></div><div class="cc-history-grid">@foreach(var m in new[]{("Nitrogen",Value(r.Nitrogen," mg/kg")),("Phosphorus",Value(r.Phosphorus," mg/kg")),("Potassium",Value(r.Potassium," mg/kg")),("Moisture",Value(r.Moisture,"%")),("pH",Value(r.Ph)),("Temperature",Value(r.Temperature,"°C")),("EC",Value(r.Ec))}){<div class="cc-history-metric"><small>@m.Item1</small><strong>@m.Item2</strong></div>}</div></article>}</div>
@if(!string.IsNullOrWhiteSpace(Model.History.NextCursor)){<a class="btn btn-light mt-4" asp-action="History" asp-route-id="@Model.SensorId" asp-route-cursor="@Model.History.NextCursor" asp-route-metric="@Model.Metric">Load older readings</a>}
@section Scripts { <script src="~/js/monitoring-chart.js" asp-append-version="true"></script> }
