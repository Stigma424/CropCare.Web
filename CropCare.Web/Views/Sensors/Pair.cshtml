@model CropCare.Web.Models.PairSensorViewModel
@{ ViewData["Title"] = "Add Sensor"; }
<div class="cc-grid"><section class="cc-card"><h2>Scan the QR code on your sensor</h2><div id="qr-reader" class="cc-qr-frame"><p>Point the camera at the QR code.</p><p class="text-muted">Open the camera or select a QR image below.</p></div><div class="cc-actions my-3"><button id="startCamera" type="button" class="btn btn-light">Open Camera</button><button id="stopCamera" type="button" class="btn btn-light" disabled>Stop</button></div><label for="qrFile" class="form-label">Or select a QR image</label><input type="file" id="qrFile" accept="image/*" class="form-control" /><p class="small text-muted mt-2">Decoded in your browser; the image is not uploaded.</p><div id="qrStatus" class="alert alert-secondary" aria-live="polite" role="status">No QR scanned yet.</div></section><section class="cc-card"><form id="pairForm" asp-action="Pair" method="post" asp-antiforgery="true" autocomplete="off" class="cc-auth-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="QrPayload" type="hidden" id="QrPayload" /><span asp-validation-for="QrPayload" class="text-danger"></span><div><label asp-for="SensorName" class="form-label">Enter Sensor Name</label><input asp-for="SensorName" class="form-control" maxlength="80" placeholder="e.g., Soil Sensor 1" /><span asp-validation-for="SensorName" class="text-danger"></span></div><div><label asp-for="ZoneId" class="form-label">Farm zone</label><select asp-for="ZoneId" class="form-select"><option value="">Select a zone</option>@foreach(var z in Model.Zones){<option value="@z.ZoneId">@z.ZoneName</option>}</select><span asp-validation-for="ZoneId" class="text-danger"></span></div>@if(Model.Zones.Count==0){<div class="alert alert-warning">Create a farm zone before pairing. <a asp-controller="Zones" asp-action="Create">Add Zone</a></div>}<div class="cc-auth-actions"><button id="pairButton" class="btn btn-success" type="submit" disabled="@(Model.Zones.Count==0)">Save</button><a class="btn btn-light" asp-controller="Zones" asp-action="Index">Cancel</a></div><p class="small text-muted">Pairing is verified by the API. An offline device can be paired; pairing does not mean readings are available. Authorized unpairing makes the original QR reusable.</p></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script><script src="~/js/sensor-pairing.js" asp-append-version="true"></script> }
