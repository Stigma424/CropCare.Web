@model CropCare.Web.Models.ZoneOverview
@{ ViewData["Title"] = "Sensor Status"; }
<div class="cc-section-heading">
    <h2>@Model.Zone.ZoneName</h2>
    <a class="btn btn-light" asp-action="Index" asp-route-zoneId="@Model.Zone.ZoneId">Refresh</a>
</div>
@if (Model.Error is string error) { <p class="alert alert-warning">@error</p> }
@if (Model.Sensors.Count == 0) { <p class="cc-empty">No sensors registered.</p> }
<div class="cc-grid">
@foreach (var snapshot in Model.Sensors)
{
    var sensor = snapshot.Sensor;
    <article class="cc-card">
        <h3>@sensor.SensorName</h3>
        <p>@snapshot.Freshness · @CropCare.Web.Models.SensorDates.Format(snapshot.Monitoring?.LastReadingAtMs ?? 0)</p>
        @if (snapshot.Error is string issue) { <p class="text-danger">@issue</p> }
        <div class="cc-actions">
            <a class="btn btn-success" asp-action="Details" asp-route-id="@sensor.SensorId">View Details</a>
            <a class="btn btn-light" asp-action="History" asp-route-id="@sensor.SensorId">View History</a>
        </div>
    </article>
}
</div>
<a class="cc-back-link" asp-controller="Zones" asp-action="Details" asp-route-id="@Model.Zone.ZoneId">Back to Zone</a>
