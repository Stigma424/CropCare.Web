@model CropCare.Web.Models.SensorDetailsViewModel
@{
    ViewData["Title"] = Model.Sensor.SensorName;
    var s = Model.Sensor;
    var reading = Model.Monitoring?.Reading;
    string Text(double? value, string unit = "") => value.HasValue ? value.Value.ToString("0.##") + unit : "—";
    var measures = reading == null ? Array.Empty<(string Label, string Value)>() : new (string Label, string Value)[]
    {
        ("Nitrogen", Text(reading.Nitrogen, " mg/kg")),
        ("Phosphorus", Text(reading.Phosphorus, " mg/kg")),
        ("Potassium", Text(reading.Potassium, " mg/kg")),
        ("Moisture", Text(reading.Moisture, "%")),
        ("pH", Text(reading.Ph)),
        ("Temperature", Text(reading.Temperature, " °C")),
        ("EC", Text(reading.Ec, " (stored units)"))
    };
}
<div class="py-4">
    <a asp-controller="Sensors" asp-action="Index" asp-route-zoneId="@s.ZoneId" class="text-success text-decoration-none">
        &larr; Back to Zone Sensors
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-3 mb-4">
        <div>
            <h1 class="fw-bold text-success mb-1">@s.SensorName</h1>
            <p class="text-muted mb-1">Device ID: @s.DeviceId</p>
            <span class="badge @(Model.Monitoring?.Status == "recent" ? "bg-success" : "bg-secondary")">
                @(Model.Monitoring?.Status == "recent" ? "Recent reading" : Model.Monitoring?.Status == "stale" ? "Stale / historical" : "Unavailable / awaiting data")
            </span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Rename" asp-route-id="@s.SensorId" class="btn btn-outline-success">Edit Sensor Name</a>
            <a asp-action="History" asp-route-id="@s.SensorId" class="btn btn-success">View Full History &rarr;</a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.MonitoringError))
    {
        <div class="alert alert-warning">@Model.MonitoringError</div>
    }
    <div class="alert alert-info small" role="note">
        Last stored reading: @CropCare.Web.Models.SensorDates.Format(Model.Monitoring?.LastReadingAtMs ?? 0).
        This is not proof the sensor is currently online.
    </div>
    <h2 class="h5 fw-bold text-success">Latest 7-in-1 Soil Reading</h2>
    @if (reading == null)
    {
        <div class="alert alert-secondary">No saved reading is available for this sensor.</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 mb-4">
            @foreach (var metric in measures)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-body p-3">
                            <div class="text-muted small">@metric.Label</div>
                            <div class="fw-bold text-success fs-5">@metric.Value</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <div class="card border-danger rounded-4">
        <div class="card-body p-4">
            <h2 class="h6 text-danger">Remove sensor registration</h2>
            <p class="text-muted small">Unpairing releases this device for pairing again with its original QR. Historical readings remain stored.</p>
            <form asp-action="Delete" asp-route-id="@s.SensorId" method="post" asp-antiforgery="true"
                  onsubmit="return confirm('Remove sensor registration?');">
                <button class="btn btn-outline-danger" type="submit">Remove Sensor</button>
            </form>
        </div>
    </div>
</div>