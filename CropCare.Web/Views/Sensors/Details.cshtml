@model CropCare.Web.Models.SensorDetailsViewModel
@using CropCare.Web.Models
@{ ViewData["Title"] = Model.Sensor.SensorName; var reading=Model.Monitoring?.Reading; string Value(double? n,string unit="") => n.HasValue ? n.Value.ToString("0.##")+unit : "—"; }
<div class="cc-section-heading"><p class="mb-0">Device: @Model.Sensor.DeviceId</p><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Sensor.SensorId">⟳ Refresh</a></div>
@if(Model.MonitoringError is not null){<div class="alert alert-warning">@Model.MonitoringError</div>}
<section class="cc-card cc-section"><p class="text-muted">Last recorded: @SensorDates.Format(Model.Monitoring?.LastReadingAtMs ?? 0) · @(Model.Monitoring?.Status switch { "recent"=>"Recent reading", "stale"=>"No recent readings", "unknown_time"=>"Timestamp unavailable", "awaiting_first_reading"=>"Awaiting first reading", _=>"Status unavailable" })</p><div class="cc-history-grid">@foreach(var m in new[]{("Nitrogen",Value(reading?.Nitrogen," mg/kg"),"nitrogen"),("Phosphorus",Value(reading?.Phosphorus," mg/kg"),"phosphorus"),("Potassium",Value(reading?.Potassium," mg/kg"),"potassium"),("Moisture",Value(reading?.Moisture,"%"),"moisture"),("pH",Value(reading?.Ph),"ph"),("Temperature",Value(reading?.Temperature,"°C"),"temperature"),("EC",Value(reading?.Ec),"ec")}){<div class="cc-history-metric"><small>@m.Item1</small><strong>@m.Item2</strong><div><a asp-action="History" asp-route-id="@Model.Sensor.SensorId" asp-route-metric="@m.Item3">View history</a></div></div>}</div></section><div class="cc-actions"><a class="btn btn-success" asp-action="History" asp-route-id="@Model.Sensor.SensorId">All history</a><a class="btn btn-light" asp-action="Rename" asp-route-id="@Model.Sensor.SensorId">Edit Sensor</a><a class="btn btn-light" asp-action="Index" asp-route-zoneId="@Model.Sensor.ZoneId">← Sensor Status</a><form asp-action="Delete" asp-route-id="@Model.Sensor.SensorId" method="post" asp-antiforgery="true" data-confirm="Unpair this sensor? The API releases authorized QR claims. Historical soil records remain stored."><button class="btn btn-danger" type="submit">Unpair sensor</button></form></div>
