@model CropCare.Web.Models.RenameSensorViewModel
@{ ViewData["Title"] = "Edit Sensor"; }
<div class="cc-grid"><section class="cc-card"><h2>Update your sensor details</h2><p class="text-muted">Registration: @Model.SensorId</p><p>Renaming a sensor preserves its device identity, QR claim and historical measurements.</p></section><section class="cc-card"><form class="cc-auth-form" asp-action="Rename" asp-route-id="@Model.SensorId" method="post" asp-antiforgery="true"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div><label asp-for="SensorName" class="form-label">Sensor name</label><input asp-for="SensorName" class="form-control" maxlength="80" /><span asp-validation-for="SensorName" class="text-danger"></span></div><div class="cc-auth-actions"><button class="btn btn-success" type="submit">Save</button><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.SensorId">Cancel</a></div></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
