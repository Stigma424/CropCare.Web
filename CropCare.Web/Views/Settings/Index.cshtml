@model CropCare.Web.Models.CropCareProfile
@{ ViewData["Title"] = "Settings"; var name = string.Join(" ",new[]{Model.FirstName,Model.MiddleName,Model.LastName}.Where(x=>!string.IsNullOrWhiteSpace(x))); var initials = string.Concat(new[]{Model.FirstName,Model.LastName}.Where(x=>!string.IsNullOrWhiteSpace(x)).Select(x=>x![0])); }
@if(ViewData["ProfileError"] is string error){<div class="alert alert-warning">@error <a asp-action="Index">Refresh</a></div>}
<div class="cc-grid cc-settings-grid"><section class="cc-card cc-stack"><div class="cc-avatar" aria-label="Profile initials">@(initials.Length>0 ? initials : "?")</div><h2 class="text-success">@(name.Length>0 ? name : "Farmer")</h2><p class="text-success">@Model.Username</p><a class="btn btn-light align-self-start" asp-controller="Profile" asp-action="Edit">Edit Profile</a></section><section class="cc-card cc-stack"><a class="cc-option" asp-action="Help"><strong>Help</strong><small>Help and About</small></a><a class="cc-option" asp-controller="Profile" asp-action="Index"><strong>Account Settings</strong><small>Your profile and password</small></a><a class="cc-option" asp-controller="Notifications" asp-action="Index"><strong>Notifications</strong><small>Saved alerts and updates</small></a><a class="cc-option" asp-controller="Subscription" asp-action="Index"><strong>Subscription</strong><small>Plan and manual receipt review</small></a><a class="btn btn-danger align-self-start" asp-controller="Account" asp-action="ConfirmLogout">Log out</a></section></div>
